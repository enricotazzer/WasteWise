# Environment
.env
.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
dist/
.vite/

# TLS certs for LAN dev — machine-specific, and the key must never be committed
web/.certs/

# Runtime state — never source: the crawl frontier (resumable, rebuildable) and fitted
# model pickles, which /api/risk/* unpickles on every request. A committed pickle is code
# execution on the next pull.
data/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
# AppleDouble sidecars macOS writes on non-APFS volumes (this repo lives on exFAT)
._*
*.swp
.idea/
