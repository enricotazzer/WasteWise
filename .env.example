# Copy to .env and fill in. .env is gitignored.

# --- Database ---
POSTGRES_USER=wastewise
POSTGRES_PASSWORD=wastewise
POSTGRES_DB=wastewise
POSTGRES_PORT=5433
# Used by the API container (host is the compose service name)
DATABASE_URL=postgresql+psycopg://wastewise:wastewise@db:5432/wastewise

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-first-run
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Seeded single user (created by `make seed`)
FIRST_USER_EMAIL=enrico.tappo00@gmail.com
FIRST_USER_PASSWORD=change-me

# --- LLM: free tiers only, no paid inference anywhere ---
# Both are optional. With neither set, everything still works: barcodes resolve through
# Open Food Facts and anything the category rules can't place lands in "Altro" for you to
# correct in one tap.
#
# Groq (primary)   https://console.groq.com  — free, no credit card
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (failover when Groq rate-limits)  https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Open Food Facts ---
# No key needed, but the User-Agent must identify the app and a contact address — generic
# agents get blocked. Put your own email here.
OFF_CONTACT_EMAIL=enrico.tappo00@gmail.com
OFF_RATE_LIMIT_PER_MIN=50

# --- App ---
TZ=Europe/Rome
DEFAULT_CURRENCY=EUR
# Add your LAN origin here if you use `make dev-https` from a phone, e.g.
# CORS_ORIGINS=http://localhost:5173,https://172.20.10.7:5173
CORS_ORIGINS=http://localhost:5173
